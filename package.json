{
    "name": "srtm-ui",
    "version": "0.1.0",
    "private": true,
    "description": "Rentas municipales (Perené): web de srtm-backend sobre @wasichai/*",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "vite",
        "preview": "vite preview",
        "lint": "prettier --check src index.html package.json tsconfig.json tsconfig.build.json vite.config.ts",
        "format": "prettier --write src index.html package.json tsconfig.json tsconfig.build.json vite.config.ts",
        "test": "vitest run",
        "build": "tsc -p tsconfig.build.json && vite build",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@wasichai/core": "link:../wasichai-ui/packages/core",
        "@wasichai/documents": "link:../wasichai-ui/packages/documents",
        "@wasichai/forms": "link:../wasichai-ui/packages/forms",
        "@wasichai/pages": "link:../wasichai-ui/packages/pages",
        "@wasichai/ui": "link:../wasichai-ui/packages/ui",
        "@wasichai/views": "link:../wasichai-ui/packages/views",
        "@wasichai/workflow": "link:../wasichai-ui/packages/workflow",
        "@tanstack/react-query": "5.103.1",
        "i18next": "26.4.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-i18next": "17.0.15",
        "react-router": "8.4.0"
    },
    "devDependencies": {
        "@wasichai/testing": "link:../wasichai-ui/packages/testing",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/node": "24.10.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "jsdom": "30.1.1",
        "prettier": "3.8.2",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.0",
        "vitest": "5.0.1"
    },
    "resolutions": {
        "@wasichai/core": "link:../wasichai-ui/packages/core",
        "@wasichai/ui": "link:../wasichai-ui/packages/ui"
    }
}
