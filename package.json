{
    "name": "srtm-ui",
    "version": "0.1.0",
    "private": true,
    "description": "Rentas municipales (Perené): web de srtm-backend sobre @wasichai/*",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "vite",
        "preview": "vite preview",
        "lint": "prettier --check src index.html package.json tsconfig.json tsconfig.build.json vite.config.ts",
        "format": "prettier --write src index.html package.json tsconfig.json tsconfig.build.json vite.config.ts",
        "test": "vitest run",
        "build": "tsc -p tsconfig.build.json && vite build",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@wasichai/core": "0.2.1",
        "@wasichai/documents": "0.2.1",
        "@wasichai/forms": "0.2.1",
        "@wasichai/pages": "0.2.1",
        "@wasichai/ui": "0.2.1",
        "@wasichai/views": "0.2.1",
        "@wasichai/workflow": "0.2.1",
        "@tanstack/react-query": "5.103.2",
        "i18next": "26.4.2",
        "lucide-react": "1.48.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "7.89.0",
        "react-i18next": "17.0.15",
        "react-router": "8.4.0"
    },
    "devDependencies": {
        "@wasichai/testing": "0.2.1",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/node": "24.10.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "jsdom": "30.1.1",
        "prettier": "3.9.9",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.0",
        "vitest": "5.0.1"
    }
}
